---
layout: layouts/base
---
<main class="{% if not wide %}compact{% endif %}">
  <header class="standard">
    <h1>{{title}}</h1>
    <div class="muted">
      {{heading_description | markdown | safe}}
    </div>
  </header>
  <div style="width:100%;position:relative;display:flex;flex-direction:column;align-items:center;">
    {{content | safe}}
  </div>
</main>